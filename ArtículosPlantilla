<section style="padding:0 20px;">
  <div class="article">

 <h1>  </h1>

<p
    <a class="volver" href="Substack.html">← Volver a artículos</a>

    <!-- COMENTARIOS (Firestore) -->
    <div class="comentarios">
      <h2>Comentarios</h2>
      <form id="c-form">
        <input type="text" id="c-nombre" placeholder="Tu nombre" maxlength="50" required>
        <textarea id="c-texto" placeholder="Escribe tu comentario..." maxlength="1000" required></textarea>
        <input type="text" id="c-web" class="c-hp" tabindex="-1" autocomplete="off">
        <button type="submit" id="c-btn">Publicar comentario</button>
        <div id="c-msg"></div>
      </form>
      <div id="c-lista"></div>
    </div>
    <script type="module">
      import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
      import { getFirestore, collection, addDoc, getDocs, query, where, serverTimestamp }
        from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

      const firebaseConfig = {
        apiKey: "AIzaSyBok-j5JN3mhsW3OrkETNdeJWlh1y_8J10",
        authDomain: "comentarios-1189c.firebaseapp.com",
        projectId: "comentarios-1189c",
        storageBucket: "comentarios-1189c.firebasestorage.app",
        messagingSenderId: "264244599698",
        appId: "1:264244599698:web:bb56d35388cfdd7e23ff4b"
      };

      const db = getFirestore(initializeApp(firebaseConfig));
      const pageId = (location.pathname.split('/').pop() || 'home').replace('.html', '');
      const lista = document.getElementById('c-lista');
      const msg = document.getElementById('c-msg');

      async function cargar() {
        try {
          const snap = await getDocs(query(collection(db, 'comentarios'), where('pageId', '==', pageId)));
          const items = snap.docs.map(d => d.data())
            .sort((a, b) => (b.fecha?.seconds || 0) - (a.fecha?.seconds || 0));
          lista.innerHTML = '';
          if (!items.length) {
            lista.innerHTML = '<p style="color:#888">Sé el primero en comentar.</p>';
            return;
          }
          items.forEach(c => {
            const div = document.createElement('div');
            div.className = 'c-item';
            const n = document.createElement('strong');
            n.textContent = c.nombre;
            const f = document.createElement('small');
            f.textContent = c.fecha ? new Date(c.fecha.seconds * 1000).toLocaleDateString('es-ES') : '';
            const p = document.createElement('p');
            p.textContent = c.texto;
            div.append(n, f, p);
            lista.appendChild(div);
          });
        } catch (e) {
          console.error(e);
          lista.innerHTML = '<p style="color:#b00">No se pudieron cargar los comentarios.</p>';
        }
      }

      document.getElementById('c-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        if (document.getElementById('c-web').value) return; // anti-bot
        const nombre = document.getElementById('c-nombre').value.trim();
        const texto = document.getElementById('c-texto').value.trim();
        if (!nombre || !texto) return;
        const last = Number(localStorage.getItem('c-last') || 0);
        if (Date.now() - last < 30000) { msg.textContent = 'Espera unos segundos antes de volver a comentar.'; return; }
        const btn = document.getElementById('c-btn');
        btn.disabled = true; msg.textContent = 'Enviando...';
        try {
          await addDoc(collection(db, 'comentarios'), { pageId, nombre, texto, fecha: serverTimestamp() });
          localStorage.setItem('c-last', Date.now());
          document.getElementById('c-texto').value = '';
          msg.textContent = '¡Gracias por tu comentario!';
          await cargar();
        } catch (err) {
          console.error(err);
          msg.textContent = 'Error al enviar. Inténtalo de nuevo.';
        }
        btn.disabled = false;
      });

      cargar();
    </script>
  </div>
