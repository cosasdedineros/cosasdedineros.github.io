<style>
#cookie-banner {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  width: calc(100% - 40px);
  max-width: 800px;
  background: #1b1b1b;
  color: #fff;
  padding: 14px 16px;
  border-radius: 12px;
  font-family: Arial, sans-serif;
  font-size: 14px;
  display: none;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  z-index: 99999;
  box-shadow: 0 8px 25px rgba(0,0,0,0.3);
}

#cookie-banner p {
  margin: 0;
  flex: 1;
  line-height: 1.3;
}

#cookie-buttons {
  display: flex;
  gap: 8px;
  flex-shrink: 0;
}

#cookie-banner button {
  border: none;
  padding: 7px 10px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 13px;
}

#accept {
  background: #4caf50;
  color: white;
}

#reject {
  background: #e53935;
  color: white;
}

#cookie-settings {
  background: #555;
  color: white;
}
</style>

<div id="cookie-banner">
  <p>
    Usamos cookies para mejorar la experiencia, analizar tráfico y mostrar anuncios personalizados.
  </p>

  <div id="cookie-buttons">
    <button id="reject" onclick="setCookies('no')">Rechazar</button>
    <button id="cookie-settings" onclick="alert('Aquí puedes ampliar opciones si quieres')">Configurar</button>
    <button id="accept" onclick="setCookies('yes')">Aceptar</button>
  </div>
</div>

<script>
function setCookies(value) {
  localStorage.setItem("cookies_consent", value);
  document.getElementById("cookie-banner").style.display = "none";

  // 🔥 Aquí puedes activar scripts SOLO si acepta
  if (value === "yes") {
    console.log("Cookies aceptadas → activar Analytics/AdSense");
    // ejemplo:
    // loadAnalytics();
    // loadAds();
  } else {
    console.log("Cookies rechazadas → no tracking");
  }
}

function shouldShowBanner() {
  return !localStorage.getItem("cookies_consent");
}

window.addEventListener("load", () => {
  if (shouldShowBanner()) {
    document.getElementById("cookie-banner").style.display = "flex";
  }
});
</script>
